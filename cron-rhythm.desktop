[Desktop Entry]
Version=1.0
Type=Application
Name=Cron Rhythm Studio
GenericName=AST Schedule Parser & Heatmap Studio
Comment=Zero-Dependency AST Schedule Parser, 24×7 Rhythm Matrix, Multi-Dialect Transpiler & DST Anomaly Auditor
Exec=/usr/local/bin/cron-rhythm desktop
Icon=/media/neo/f2fdda77-178b-4603-ae80-c7aa4cd97908/zoth-micro-repos/cron-rhythm-studio/assets/icon.png
Terminal=false
Categories=Development;System;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open Cron Rhythm CLI
Exec=x-terminal-emulator -e "/usr/local/bin/cron-rhythm --help"

[Desktop Action Web]
Name=Open Web UI (Port 8080)
Exec=/usr/local/bin/cron-rhythm web
